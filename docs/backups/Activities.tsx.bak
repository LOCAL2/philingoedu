import React, { useState } from 'react';
import { Layout } from '@/components/layout/Layout';
import { useSeoMeta } from '@/hooks/use-seo-meta';
import { useQuery } from '@tanstack/react-query';
import { Calendar, MapPin, Users, Video, ExternalLink, ArrowRight, AlertCircle, CalendarDays, CheckCircle2, Clock, Phone } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import { Link } from 'wouter';
import fairBannerFallback from '@/assets/fair-banner.png';
import qqLogo from '@assets/image_1785200772068.png';
import ciaLogo from '@assets/image_1785200711221.png';
import cpilsLogo from '@assets/image_1785200802634.png';
import philinterLogo from '@assets/image_1785200753254.png';
import bcebuLogo from '@assets/image_1785200917465.png';
import { AdminEditSection } from '@/components/AdminOverlay';

const FAIR_SCHOOLS = [
  { name: 'QQ English', location: 'IT Park',   date: '29 ส.ค. 2569', slug: 'qq-english', logo: qqLogo },
  { name: 'CIA',        location: 'Mactan',     date: '30 ส.ค. 2569', slug: 'cia',        logo: ciaLogo },
  { name: 'I.BREEZE',  location: 'Mabolo',     date: '5 ก.ย. 2569',  slug: 'ibreeze',    logo: null as string | null },
  { name: "B'Cebu",    location: 'Banilad',    date: '6 ก.ย. 2569',  slug: 'bcebu',      logo: bcebuLogo },
  { name: 'CPILS',     location: 'Downtown',   date: '12 ก.ย. 2569', slug: 'cpils',      logo: cpilsLogo },
  { name: 'Philinter', location: 'Mactan',     date: '13 ก.ย. 2569', slug: 'philinter',  logo: philinterLogo },
];

const BASE = (import.meta.env.BASE_URL ?? '').replace(/\/$/, '');

interface ApiEvent {
  id: number;
  titleTh: string; title: string | null;
  descriptionTh: string | null; description: string | null;
  eventDate: string | null; eventTime: string | null;
  venueTh: string | null; venue: string | null;
  meetUrl: string | null; imageUrl: string | null;
  eventType: string | null;
  ctaTextTh: string | null; ctaUrl: string | null;
  seatsTotal: number | null; seatsRemaining: number | null;
  isFeatured: boolean; isActive: boolean; sortOrder: number;
}

const TYPE_COLORS: Record<string, string> = {
  seminar:  'bg-blue-100 text-blue-700',
  workshop: 'bg-purple-100 text-purple-700',
  online:   'bg-teal-100 text-teal-700',
  offline:  'bg-orange-100 text-orange-700',
};
const TYPE_LABELS: Record<string, string> = {
  seminar: '🎓 Seminar', workshop: '🛠️ Workshop', online: '💻 ออนไลน์', offline: '📍 Onsite',
};

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
}

/* ── Registration modal ───────────────────────────────── */
function RegisterModal({ event, onClose }: { event: ApiEvent; onClose: () => void }) {
  const [form, setForm] = useState({ name: '', email: '', phone: '', lineId: '', note: '' });
  const [loading, setLoading] = useState(false);
  const [done, setDone] = useState(false);
  const [error, setError] = useState('');

  const inp = 'w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition bg-gray-50 dark:bg-gray-700 dark:border-gray-600 dark:text-white placeholder:text-gray-400';

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!form.name.trim()) { setError('กรุณาระบุชื่อ'); return; }
    setLoading(true); setError('');
    try {
      const res = await fetch(`${BASE}/api/events/${event.id}/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: form.name, email: form.email || undefined, phone: form.phone || undefined, lineId: form.lineId || undefined, note: form.note || undefined }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'เกิดข้อผิดพลาด');
      setDone(true);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'เกิดข้อผิดพลาด กรุณาลองใหม่');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm" onClick={onClose}>
      <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} exit={{ opacity: 0, scale: 0.95 }}
        className="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-md overflow-hidden" onClick={e => e.stopPropagation()}>
        {/* Header */}
        <div className="bg-gradient-to-r from-primary to-[#0ea5e9] p-6 text-white">
          <p className="text-sm text-white/70 mb-1">ลงทะเบียนเข้าร่วม</p>
          <h2 className="text-xl font-bold leading-tight">{event.titleTh}</h2>
          {event.eventDate && (
            <p className="text-sm text-white/80 mt-2 flex items-center gap-1.5">
              <Calendar className="h-4 w-4" />
              {formatDate(event.eventDate)}{event.eventTime && ` · ${event.eventTime}`}
            </p>
          )}
        </div>

        <div className="p-6">
          {done ? (
            <div className="text-center py-2">
              <div className="text-4xl mb-2">🎉</div>
              <h3 className="text-xl font-bold text-gray-900 dark:text-white mb-1">ลงทะเบียนสำเร็จ!</h3>
              <p className="text-gray-500 dark:text-gray-400 text-sm mb-3">ขอบคุณที่ลงทะเบียนนะคะ ทีมงานจะติดต่อกลับเร็วๆ นี้</p>
              {/* Submitted data summary */}
              <div className="bg-gray-50 dark:bg-gray-700 rounded-xl p-3 mb-3 text-left text-sm space-y-1.5">
                {[['ชื่อ', form.name], ['อีเมล', form.email], ['เบอร์โทร', form.phone], ['LINE ID', form.lineId], ['หมายเหตุ', form.note]].filter(([, v]) => v).map(([l, v]) => (
                  <div key={l} className="flex gap-2"><span className="text-gray-400 w-20 shrink-0">{l}</span><span className="text-gray-700 dark:text-gray-200 font-medium">{v}</span></div>
                ))}
              </div>
              {/* LINE CTA */}
              <div className="bg-[#00B900]/10 border border-[#00B900]/30 rounded-xl p-3 mb-3">
                <p className="text-xs text-gray-600 dark:text-gray-300 mb-2 font-medium">🎁 รับใบเสนอราคาและโปรโมชั่นพิเศษผ่าน LINE</p>
                <a href="https://lin.ee/nBR4rsN" target="_blank" rel="noreferrer"
                  className="flex items-center justify-center gap-2 bg-[#00B900] hover:bg-[#00A000] text-white font-bold px-4 py-2.5 rounded-xl transition-all w-full text-sm">
                  แอด LINE Official รับใบเสนอราคาโปรโมชั่น (@philingo)
                </a>
              </div>
              <button onClick={onClose} className="text-sm text-gray-400 hover:text-primary transition-colors">ปิด</button>
            </div>
          ) : (
            <form onSubmit={handleSubmit} className="space-y-3">
              {error && <p className="text-sm text-red-600 bg-red-50 border border-red-200 rounded-xl px-4 py-2">{error}</p>}

              <div>
                <label className="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">ชื่อ-นามสกุล <span className="text-red-500">*</span></label>
                <input type="text" required placeholder="เช่น สมชาย ใจดี" className={inp}
                  value={form.name} onChange={e => setForm(p => ({ ...p, name: e.target.value }))} />
              </div>
              <div>
                <label className="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">
                  อีเมล <span className="text-xs text-gray-400 font-normal">(รับ link เข้าร่วมอัตโนมัติ)</span>
                </label>
                <input type="email" placeholder="example@email.com" className={inp}
                  value={form.email} onChange={e => setForm(p => ({ ...p, email: e.target.value }))} />
              </div>
              <div>
                <label className="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">เบอร์โทรศัพท์</label>
                <input type="tel" placeholder="08X-XXX-XXXX" className={inp}
                  value={form.phone} onChange={e => setForm(p => ({ ...p, phone: e.target.value }))} />
              </div>
              <div>
                <label className="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">LINE ID</label>
                <input type="text" placeholder="@yourlineid" className={inp}
                  value={form.lineId} onChange={e => setForm(p => ({ ...p, lineId: e.target.value }))} />
              </div>
              <div>
                <label className="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">หมายเหตุ / คำถาม</label>
                <textarea rows={2} placeholder="มีคำถามหรือต้องการข้อมูลเพิ่มเติม..." className={inp + ' resize-none'}
                  value={form.note} onChange={e => setForm(p => ({ ...p, note: e.target.value }))} />
              </div>

              <div className="flex gap-2 pt-2">
                <button type="button" onClick={onClose}
                  className="flex-1 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300 py-2.5 rounded-xl font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                  ยกเลิก
                </button>
                <button type="submit" disabled={loading}
                  className="flex-1 bg-primary text-white py-2.5 rounded-xl font-semibold hover:bg-primary/90 disabled:opacity-60 transition-colors flex items-center justify-center gap-2">
                  {loading ? <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin" /> : null}
                  {loading ? 'กำลังส่ง...' : '✅ ยืนยันลงทะเบียน'}
                </button>
              </div>
            </form>
          )}
        </div>
      </motion.div>
    </div>
  );
}

/* ── Inline Registration Form for Education Fair ─────── */
const FAIR_EVENT_ID = 1;

function FairRegistrationForm() {
  const [form, setForm] = useState({ name: '', phone: '', lineId: '', email: '', note: '' });
  const [loading, setLoading] = useState(false);
  const [done, setDone] = useState(false);
  const [error, setError] = useState('');

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!form.name.trim()) { setError('กรุณาระบุชื่อ'); return; }
    if (!form.phone.trim() && !form.lineId.trim()) { setError('กรุณาระบุเบอร์โทรหรือ LINE ID'); return; }
    setError(''); setLoading(true);
    try {
      const res = await fetch(`${BASE}/api/events/${FAIR_EVENT_ID}/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: form.name, phone: form.phone || undefined, lineId: form.lineId || undefined, email: form.email || undefined, note: form.note || undefined }),
      });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error ?? 'เกิดข้อผิดพลาด'); }
      setDone(true);
    } catch (err: any) {
      setError(err.message ?? 'เกิดข้อผิดพลาด กรุณาลองใหม่');
    } finally {
      setLoading(false);
    }
  };

  const LINE_URL = `https://lin.ee/nBR4rsN`;
  const LINE_ID  = '@philingo';

  if (done) return (
    <div className="text-center py-4">
      <div className="text-5xl mb-3">🎉</div>
      <h3 className="text-xl font-bold text-gray-900 dark:text-white mb-1">ลงทะเบียนสำเร็จ!</h3>
      <p className="text-gray-500 dark:text-gray-400 text-sm mb-4">ขอบคุณที่ลงทะเบียนนะคะ ทีมงาน Philingo จะติดต่อกลับเร็วๆ นี้</p>
      {/* Submitted data summary */}
      <div className="bg-gray-50 dark:bg-gray-700 rounded-xl p-3 mb-4 text-left text-sm space-y-1.5">
        {[['ชื่อ', form.name], ['เบอร์โทร', form.phone], ['LINE ID', form.lineId], ['อีเมล', form.email], ['หมายเหตุ', form.note]].filter(([, v]) => v).map(([l, v]) => (
          <div key={l} className="flex gap-2"><span className="text-gray-400 w-20 shrink-0">{l}</span><span className="text-gray-700 dark:text-gray-200 font-medium">{v}</span></div>
        ))}
      </div>
      {/* LINE CTA */}
      <div className="bg-[#00B900]/10 border border-[#00B900]/30 rounded-xl p-3 mb-3">
        <p className="text-xs text-gray-600 dark:text-gray-300 mb-2 font-medium">🎁 รับใบเสนอราคาและโปรโมชั่นพิเศษผ่าน LINE</p>
        <a href={LINE_URL} target="_blank" rel="noreferrer"
          className="flex items-center justify-center gap-2 bg-[#00B900] hover:bg-[#00A000] text-white font-bold px-4 py-2.5 rounded-xl transition-all w-full text-sm">
          <svg viewBox="0 0 24 24" className="w-4 h-4 fill-current"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.070 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          แอด LINE รับใบเสนอราคาโปรโมชั่น ({LINE_ID})
        </a>
      </div>
    </div>
  );

  return (
    <form onSubmit={handleSubmit} className="space-y-3">
      <div>
        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ชื่อ-นามสกุล <span className="text-red-500">*</span></label>
        <input required className="w-full border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:text-white"
          placeholder="ชื่อ-นามสกุล" value={form.name} onChange={e => setForm(p => ({ ...p, name: e.target.value }))} />
      </div>
      <div className="grid grid-cols-2 gap-3">
        <div>
          <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">เบอร์โทรศัพท์</label>
          <input className="w-full border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:text-white"
            placeholder="08x-xxx-xxxx" value={form.phone} onChange={e => setForm(p => ({ ...p, phone: e.target.value }))} />
        </div>
        <div>
          <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">LINE ID</label>
          <input className="w-full border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:text-white"
            placeholder="@line_id" value={form.lineId} onChange={e => setForm(p => ({ ...p, lineId: e.target.value }))} />
        </div>
      </div>
      <div>
        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">อีเมล (รับลิงก์เข้าร่วม)</label>
        <input type="email" className="w-full border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:text-white"
          placeholder="email@example.com" value={form.email} onChange={e => setForm(p => ({ ...p, email: e.target.value }))} />
      </div>
      <div>
        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">โรงเรียนที่สนใจ / คำถาม</label>
        <textarea rows={2} className="w-full border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:text-white resize-none"
          placeholder="เช่น สนใจ QQ English, CIA, I.BREEZE..." value={form.note} onChange={e => setForm(p => ({ ...p, note: e.target.value }))} />
      </div>
      {error && <p className="text-red-500 text-sm">{error}</p>}
      <button type="submit" disabled={loading}
        className="w-full bg-[#FF3B6B] hover:bg-[#e0295a] disabled:opacity-60 text-white font-bold py-3 rounded-xl transition-all text-base">
        {loading ? 'กำลังส่ง...' : '🎟️ ยืนยันลงทะเบียนเข้าร่วมฟรี'}
      </button>
      <p className="text-center text-xs text-gray-400">ฟรี! ไม่มีค่าใช้จ่าย · รับสิทธิพิเศษเฉพาะผู้เข้าร่วมงานมูลค่ากว่า 5,000 บาท</p>
    </form>
  );
}

/* ── Main page ────────────────────────────────────────── */
export default function Activities() {
  const [registerEvent, setRegisterEvent] = useState<ApiEvent | null>(null);
  useSeoMeta(
    'กิจกรรมและประสบการณ์นักเรียน Philingo | Philingo',
    'ดูกิจกรรมสนุกๆ ของนักเรียน Philingo ที่ฟิลิปปินส์ ทั้งทริปท่องเที่ยว กีฬา และกิจกรรมนอกห้องเรียน'
  );

  const { data, isLoading } = useQuery<{ data: ApiEvent[]; total: number }>({
    queryKey: ['activities'],
    queryFn: () => fetch(`${BASE}/api/events?isActive=true&limit=50`).then(r => r.json()),
    staleTime: 60_000,
  });

  const { data: bannersData } = useQuery<{ data: { imageUrl: string }[] }>({
    queryKey: ['activity-banner'],
    queryFn: () => fetch(`${BASE}/api/banners?isActive=true&limit=1`).then(r => r.ok ? r.json() : { data: [] }),
    staleTime: 60_000,
  });
  const heroBannerUrl = bannersData?.data?.[0]?.imageUrl || fairBannerFallback;

  const events = data?.data ?? [];
  const featured = events.filter(e => e.isFeatured);
  const upcoming = events.filter(e => !e.isFeatured);

  return (
    <Layout>
      {/* Hero Banner — full image from CMS, no overlay */}
      <AdminEditSection href="/admin/banners" label="แก้ไขแบนเนอร์กิจกรรม">
        <section className="w-full">
          <img
            src={heroBannerUrl}
            alt="Philingo Cebu Online Education Fair 2026"
            className="w-full h-auto block"
          />
        </section>
      </AdminEditSection>

      {/* Participating Schools */}
      <section className="py-12 bg-white dark:bg-gray-900">
        <div className="container max-w-6xl mx-auto px-4">
          <h2 className="text-2xl md:text-3xl font-bold text-center text-gray-900 dark:text-white mb-2">
            6 สถาบันชั้นนำในเซบู ที่คุณไม่ควรพลาด!
          </h2>
          <p className="text-center text-gray-500 dark:text-gray-400 mb-8">พูดคุยสดกับตัวแทนโรงเรียน รับโปรโมชั่นพิเศษเฉพาะผู้เข้าร่วมงาน!</p>
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            {FAIR_SCHOOLS.map((s) => (
              <Link key={s.slug} href={`/schools/${s.slug}`}
                className="flex flex-col items-center bg-gray-50 dark:bg-gray-800 rounded-2xl p-4 hover:shadow-md hover:-translate-y-1 transition-all text-center group">
                <div className="w-16 h-16 rounded-full bg-white dark:bg-gray-700 flex items-center justify-center mb-3 shadow-sm border border-gray-100 dark:border-gray-600 overflow-hidden group-hover:shadow-md transition-all">
                  {s.logo ? (
                    <img src={s.logo} alt={s.name} className="w-12 h-12 object-contain" />
                  ) : (
                    <span className="text-primary font-bold text-sm">{s.name.charAt(0)}</span>
                  )}
                </div>
                <p className="font-bold text-sm text-gray-900 dark:text-white mb-1">{s.name}</p>
                <p className="text-xs text-gray-500 flex items-center gap-1 mb-1"><MapPin className="w-3 h-3" />{s.location}</p>
                <p className="text-xs text-primary font-medium">{s.date}</p>
              </Link>
            ))}
          </div>
        </div>
      </section>

      {/* Registration Form + Event Cards */}
      <div className="py-12 bg-gray-50 dark:bg-gray-900">
        <div className="container max-w-6xl mx-auto px-4">
          {/* Event cards (if any) */}
          {isLoading && (
            <div className="flex items-center justify-center py-12">
              <div className="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin" />
            </div>
          )}
          {featured.length > 0 && (
            <div className="mb-10">
              <h2 className="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
                <span className="text-yellow-500">⭐</span> กิจกรรมเด่น
              </h2>
              <div className="grid md:grid-cols-2 gap-6">
                {featured.map((ev, i) => <EventCard key={ev.id} event={ev} featured index={i} onRegister={() => setRegisterEvent(ev)} />)}
              </div>
            </div>
          )}
          {upcoming.length > 0 && (
            <div className="mb-10">
              {featured.length > 0 && <h2 className="text-2xl font-bold text-gray-900 dark:text-white mb-6">กิจกรรมทั้งหมด</h2>}
              <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {upcoming.map((ev, i) => <EventCard key={ev.id} event={ev} index={i} onRegister={() => setRegisterEvent(ev)} />)}
              </div>
            </div>
          )}

          {/* Inline Registration Form — always visible */}
          <div className="max-w-2xl mx-auto">
            <div className="bg-white dark:bg-gray-800 rounded-3xl shadow-xl overflow-hidden">
              <div className="bg-gradient-to-r from-[#0a1a3a] to-[#1a3a6a] px-8 py-6 text-white text-center">
                <p className="text-sm text-white/70 mb-1">งานสัมมนาเรียนต่อฟิลิปปินส์ ออนไลน์ 2026</p>
                <h3 className="text-2xl font-bold mb-1">🎟️ ลงทะเบียนเข้าร่วมฟรี</h3>
                <p className="text-white/80 text-sm">29 ส.ค. – 13 ก.ย. 2569 · 10:00–11:00 น. (เวลาไทย) · ออนไลน์ผ่าน Google Meet</p>
              </div>
              <div className="px-8 py-6">
                <FairRegistrationForm />
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* CTA */}
      <section className="py-16 bg-gradient-to-r from-primary to-[#0ea5e9] text-white">
        <div className="container max-w-4xl mx-auto px-4 text-center">
          <h2 className="text-2xl md:text-3xl font-bold mb-4">ไม่อยากพลาดกิจกรรมใหม่?</h2>
          <p className="text-white/80 mb-8">ลงทะเบียนรับข่าวสารและกิจกรรมพิเศษจาก Philingo ก่อนใคร</p>
          <Link href="/seminars" className="inline-flex items-center gap-2 bg-[#F5B800] hover:bg-[#e0a800] text-gray-900 font-bold px-8 py-3.5 rounded-xl text-base hover:scale-105 transition-all shadow-xl">
            ลงทะเบียนเข้าร่วมงานฟรี <ArrowRight className="h-4 w-4" />
          </Link>
        </div>
      </section>

      {/* Registration modal */}
      <AnimatePresence>
        {registerEvent && <RegisterModal event={registerEvent} onClose={() => setRegisterEvent(null)} />}
      </AnimatePresence>
    </Layout>
  );
}

/* ── Event card ──────────────────────────────────────── */
function EventCard({ event: ev, featured = false, index, onRegister }: {
  event: ApiEvent; featured?: boolean; index: number; onRegister: () => void;
}) {
  const seatsLeft = ev.seatsRemaining ?? ev.seatsTotal;
  const seatsFull = seatsLeft !== null && seatsLeft <= 0;

  return (
    <motion.div initial={{ opacity: 0, y: 24 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }}
      transition={{ delay: index * 0.06 }}
      className={`bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden hover:shadow-lg transition-shadow flex flex-col ${featured ? 'ring-2 ring-yellow-300' : ''}`}>
      {ev.imageUrl ? (
        <div className="relative h-44 overflow-hidden">
          <img src={ev.imageUrl} alt={ev.titleTh} className="w-full h-full object-cover" />
          {ev.eventType && (
            <span className={`absolute top-3 left-3 text-xs font-semibold px-2.5 py-1 rounded-full ${TYPE_COLORS[ev.eventType] ?? 'bg-gray-100 text-gray-600'}`}>
              {TYPE_LABELS[ev.eventType] ?? ev.eventType}
            </span>
          )}
          {featured && <span className="absolute top-3 right-3 text-xs font-semibold bg-yellow-400 text-gray-900 px-2.5 py-1 rounded-full">⭐ แนะนำ</span>}
        </div>
      ) : (
        <div className="h-20 bg-gradient-to-br from-primary/10 to-blue-100 flex items-center justify-center">
          <Calendar className="h-8 w-8 text-primary/40" />
        </div>
      )}

      <div className="p-5 flex flex-col flex-1">
        <h3 className="font-bold text-lg text-gray-900 dark:text-white leading-snug mb-2">{ev.titleTh}</h3>
        {ev.descriptionTh && <p className="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4 line-clamp-2">{ev.descriptionTh}</p>}

        <div className="space-y-1.5 mt-auto">
          {ev.eventDate && (
            <div className="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
              <Calendar className="h-4 w-4 text-primary shrink-0" />
              <span>{formatDate(ev.eventDate)}{ev.eventTime && ` · ${ev.eventTime}`}</span>
            </div>
          )}
          {ev.venueTh && (
            <div className="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
              {ev.eventType === 'offline' ? <MapPin className="h-4 w-4 text-primary shrink-0" /> : <Video className="h-4 w-4 text-primary shrink-0" />}
              <span>{ev.venueTh}</span>
            </div>
          )}
          {seatsLeft !== null && (
            <div className="flex items-center gap-2 text-sm">
              {seatsFull
                ? <><AlertCircle className="h-4 w-4 text-red-500 shrink-0" /><span className="text-red-500 font-medium">ที่นั่งเต็มแล้ว</span></>
                : <><Users className="h-4 w-4 text-green-500 shrink-0" /><span className="text-green-600">เหลือ {seatsLeft} ที่นั่ง{ev.seatsTotal ? ` / ${ev.seatsTotal}` : ''}</span></>
              }
            </div>
          )}
        </div>

        <div className="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
          <button onClick={onRegister} disabled={seatsFull}
            className={`w-full flex items-center justify-center gap-2 font-semibold px-4 py-2.5 rounded-xl text-sm transition-all hover:scale-[1.02] ${seatsFull ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-primary text-white hover:bg-primary/90'}`}>
            {seatsFull ? 'ที่นั่งเต็มแล้ว' : (ev.ctaTextTh ?? '📝 ลงทะเบียนเข้าร่วม')}
            {!seatsFull && <ArrowRight className="h-4 w-4" />}
          </button>
        </div>
      </div>
    </motion.div>
  );
}
